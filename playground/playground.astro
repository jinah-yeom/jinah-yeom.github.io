---

<!-- <BaseLayout title="Playground"> -->
<section class="pg" aria-labelledby="pg-title">
  <header class="pg-head">
    <h1 id="pg-title">Playground</h1>
    <p class="pg-lede">
      프로덕트 작업 밖에서 해온 그래픽·브랜딩 작업 아카이브.
      브랜드 아이덴티티부터 IPTV 화면 규격까지, 연차별로 쌓아둡니다.
    </p>
  </header>

  <ul class="pg-grid" role="list">
    {works.map((w, i) => (
      <li class="pg-item">
        <button
          class="pg-thumb"
          type="button"
          data-index={i}
          data-title={w.title}
          data-client={w.client}
          data-year={w.year}
          data-src={w.src}
          aria-label={`${w.title} 크게 보기`}
        >
          <img src={w.src} alt={`${w.title} — ${w.client}`} loading="lazy" decoding="async" />
          <span class="pg-chip" aria-hidden="true">{w.title}</span>
        </button>
      </li>
    ))}
  </ul>
</section>

<dialog class="pg-lightbox" id="pg-lightbox" aria-label="작업 크게 보기">
  <button class="pg-close" type="button" data-close aria-label="닫기">×</button>
  <button class="pg-nav pg-prev" type="button" data-prev aria-label="이전 작업">←</button>
  <figure>
    <img id="pg-lb-img" src="" alt="" />
    <figcaption id="pg-lb-caption"></figcaption>
  </figure>
  <button class="pg-nav pg-next" type="button" data-next aria-label="다음 작업">→</button>
</dialog>
<!-- </BaseLayout> -->

<style>
  /* 사이트 토큰이 있으면 아래 4개 변수만 페이지 상위에서 재정의하면 됩니다. */
  .pg {
    --pg-bg: var(--color-bg, #fafafa);
    --pg-fg: var(--color-fg, #17171b);
    --pg-muted: var(--color-muted, #6b6b76);
    --pg-line: var(--color-line, #e6e6ea);

    max-width: 1200px;
    margin: 0 auto;
    padding: 96px 24px 120px;
    color: var(--pg-fg);
  }
  @media (prefers-color-scheme: dark) {
    .pg {
      --pg-bg: var(--color-bg, #101013);
      --pg-fg: var(--color-fg, #ececf1);
      --pg-muted: var(--color-muted, #8b8b96);
      --pg-line: var(--color-line, #26262c);
    }
  }

  .pg-head { max-width: 560px; margin-bottom: 56px; }
  .pg-head h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .pg-lede {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--pg-muted);
    margin: 0;
  }

  /* Cosmos식 masonry: CSS columns */
  .pg-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3;
    column-gap: 12px;
  }
  @media (max-width: 900px) { .pg-grid { columns: 2; } }
  @media (max-width: 560px) { .pg-grid { columns: 1; } }

  .pg-item {
    break-inside: avoid;
    margin: 0 0 12px;
  }

  .pg-thumb {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 1px solid var(--pg-line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--pg-bg);
    cursor: zoom-in;
  }
  .pg-thumb img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.35s ease;
  }
  .pg-thumb:hover img,
  .pg-thumb:focus-visible img { transform: scale(1.02); }
  .pg-thumb:focus-visible {
    outline: 2px solid var(--pg-fg);
    outline-offset: 2px;
  }

  .pg-chip {
    position: absolute;
    left: 10px;
    bottom: 10px;
    padding: 5px 10px;
    font-size: 0.78rem;
    line-height: 1;
    color: #fff;
    background: rgba(10, 10, 14, 0.72);
    border-radius: 99px;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }
  .pg-thumb:hover .pg-chip,
  .pg-thumb:focus-visible .pg-chip { opacity: 1; transform: translateY(0); }

  /* Lightbox */
  .pg-lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    display: none;
  }
  .pg-lightbox[open] {
    display: grid;
    place-items: center;
    background: rgba(8, 8, 12, 0.92);
  }
  .pg-lightbox::backdrop { background: transparent; }

  .pg-lightbox figure {
    margin: 0;
    max-width: min(1400px, 92vw);
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
  }
  .pg-lightbox img {
    max-width: 100%;
    max-height: calc(88vh - 48px);
    object-fit: contain;
    border-radius: 6px;
  }
  .pg-lightbox figcaption {
    font-size: 0.875rem;
    color: #c9c9d2;
    text-align: center;
  }

  .pg-close, .pg-nav {
    position: fixed;
    z-index: 2;
    border: 0;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    width: 44px;
    height: 44px;
    border-radius: 99px;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .pg-close:hover, .pg-nav:hover { background: rgba(255, 255, 255, 0.18); }
  .pg-close { top: 20px; right: 20px; }
  .pg-prev { left: 20px; top: 50%; transform: translateY(-50%); }
  .pg-next { right: 20px; top: 50%; transform: translateY(-50%); }
  @media (max-width: 560px) {
    .pg-prev, .pg-next { top: auto; bottom: 20px; transform: none; }
    .pg-prev { left: 20px; }
    .pg-next { right: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pg-thumb img, .pg-chip { transition: none; }
  }
</style>

<script is:inline>
  (() => {
    const lightbox = document.getElementById('pg-lightbox');
    const lbImg = document.getElementById('pg-lb-img');
    const lbCap = document.getElementById('pg-lb-caption');
    const thumbs = [...document.querySelectorAll('.pg-thumb')];
    let current = 0;

    const show = (i) => {
      current = (i + thumbs.length) % thumbs.length;
      const t = thumbs[current];
      lbImg.src = t.dataset.src;
      lbImg.alt = `${t.dataset.title} — ${t.dataset.client}`;
      lbCap.textContent = [t.dataset.title, t.dataset.client, t.dataset.year]
        .filter(Boolean).join(' · ');
    };

    thumbs.forEach((t, i) => t.addEventListener('click', () => {
      show(i);
      lightbox.showModal();
    }));

    lightbox.querySelector('[data-close]').addEventListener('click', () => lightbox.close());
    lightbox.querySelector('[data-prev]').addEventListener('click', () => show(current - 1));
    lightbox.querySelector('[data-next]').addEventListener('click', () => show(current + 1));

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) lightbox.close();
    });
    lightbox.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    lightbox.addEventListener('close', () => { lbImg.src = ''; });
  })();
</script>
